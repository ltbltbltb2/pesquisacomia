{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pesquisacomia",
  "main": "security-worker.mjs",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "preview_urls": false,
  "workers_dev": false,
  "build": {
    "command": "node privacy-build.mjs"
  }
}
